# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN="75--5JB61uiJY4"
OPENAI_API_KEY=""
OPENAI_MAIN_MODEL="gpt-5"
OPENAI_UTILITY_MODEL="gpt-5-mini"
LOCAL_UTILITY_MODEL_REF="utility:heuristic"

# Deepgram API key for voice transcription
DEEPGRAM_API_KEY=""

# STT/TTS providers (adapter-based)
STT_PROVIDER="deepgram"
STT_LANGUAGE_DEFAULT="ru"
STT_DEEPGRAM_MODEL="nova-3"
TTS_PROVIDER="none"
TTS_VOICE=""
TTS_DEEPGRAM_ENCODING="opus"
TTS_DEEPGRAM_CONTAINER="ogg"

# Todoist API key for task management
TODOIST_API_KEY="63b6f722b41ea14d19d458673d34b2609afb4534"

# Path to Obsidian vault directory
VAULT_PATH=./vault

# JSON array of Telegram user IDs allowed to use the bot (empty = block all)
ALLOWED_USER_IDS=[]
# Allow all users to access the bot (not recommended for production)
ALLOW_ALL_USERS=false
# Disable aiogram polling when another gateway polls Telegram
D_BRAIN_TELEGRAM_DISABLED=0

# SQLite database path and migrations directory
DB_PATH=./data/app.db
MIGRATIONS_PATH=./deploy/migrations

TIMEZONE=UTC
SIDECAR_PAYLOAD_LIMIT_BYTES=32768
HEARTBEAT_STATE_PATH=./data/heartbeat_state.json

# Strict model routing policy
MODEL_ROUTE_MAIN_REASONING_PROVIDER="openai"
MODEL_ROUTE_VOICE_REASONING_PROVIDER="openai"
MODEL_ROUTE_HEARTBEAT_PROVIDER="local"
MODEL_ROUTE_CRON_SUMMARY_PROVIDER="local"
MODEL_ROUTE_LIGHT_CLASSIFICATION_PROVIDER="local"
MODEL_ROUTE_COMMAND_STATUS_PROVIDER="deterministic"
MODEL_ROUTE_ALLOW_LOCAL_TO_OPENAI_FALLBACK=true
MODEL_ROUTE_ALLOW_OPENAI_TO_LOCAL_FALLBACK=false
# Dev/smoke switches
MODEL_ROUTE_FORCE_OPENAI_UNAVAILABLE=false
MODEL_ROUTE_FORCE_LOCAL_UNAVAILABLE=false
SCHEDULER_HEARTBEAT_INTERVAL_MINUTES_DEFAULT=30
SCHEDULER_HEARTBEAT_ENABLED_DEFAULT=true
SCHEDULER_DIGEST_ENABLED_DEFAULT=false
SCHEDULER_DIGEST_DAILY_TIME_DEFAULT="09:30"

# Backup settings
BACKUP_DIR=./data/backups
BACKUP_PREFIX=db_backup
BACKUP_RETENTION=6
BACKUP_SNAPSHOT_ENABLED=true
# JSON array of project-relative paths to include in snapshot ZIP
BACKUP_SNAPSHOT_PATHS=["docs"]
